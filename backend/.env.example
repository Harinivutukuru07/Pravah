# =============================================
# PRAVAH Backend Environment Variables
# =============================================

# Database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/pravah_db?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173"
